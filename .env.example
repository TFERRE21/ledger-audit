NODE_ENV=development
PORT=3000

# Read-only public/EVM RPC
RPC_URL=
CHAIN=ethereum

# Live scan defaults
FROM_BLOCK=0
TO_BLOCK=0

# Historical Ethereum scan: starts at genesis block 0 and advances in resumable batches.
HISTORICAL_SCAN=true
HISTORICAL_START_BLOCK=0
HISTORICAL_BATCH_BLOCKS=1000

# Monitor continuously; while historical scan is catching up, each cycle advances the cursor.
MONITOR=true
SCAN_INTERVAL_SECONDS=60
BLOCK_CONCURRENCY=4
BLOCK_DELAY_MS=25
PROGRESS_EVERY_BLOCKS=25
CONTRACT_SCAN_LIMIT=50

# Recovery remains disabled until ownership, authority and recovery mechanism are verified.
RECOVERY_MODE=DRY_RUN
AUTO_RECOVERY=false
RECOVERY_SIGNER_MODE=external
RECOVERY_SIGNER_ADDRESS=
AUTHORIZED_DESTINATION_ADDRESS=

# Ethereum Mainnet recovery authorization registry.
# OPERATOR_ADDRESS is public; PRIVATE_KEY must be the private key of that same wallet and must never be committed.
RECOVERY_REGISTRY_CHAIN_ID=1
RECOVERY_REGISTRY_RPC_URL=
RECOVERY_REGISTRY_ADDRESS=
RECOVERY_REGISTRY_OPERATOR_ADDRESS=
RECOVERY_REGISTRY_OPERATOR_PRIVATE_KEY=

# Optional database connection for the persistence phase
DATABASE_URL=

# Optional exchange read-only credentials.
# Not required to pay Ethereum gas.
BINANCE_API_KEY=
BINANCE_API_SECRET=
SCANNER_RESTART_DELAY_MS=5000
